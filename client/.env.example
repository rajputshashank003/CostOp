# Google OAuth Client ID (matching your backend Google Client ID)
VITE_GOOGLE_CLIENT_ID=""

# CostOp Backend API URL
VITE_API_URL="http://localhost:8081/api"

# Razorpay Key ID (rzp_test_... or rzp_live_...)
VITE_RAZORPAY_KEY_ID=""

# Platform Administrator Email (must match ADMIN_EMAIL in backend api/.env)
VITE_ADMIN_EMAIL="admin@example.com"
