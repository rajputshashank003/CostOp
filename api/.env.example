# PostgreSQL Connection String (e.g. Neon, AWS RDS, Supabase, or local Postgres)
POSTGRES_DSN="host=localhost user=postgres password=postgres dbname=costop port=5432 sslmode=disable"

# Google OAuth Credentials (console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Auth & Security
JWT_SECRET="" # required: random, at least 32 chars (openssl rand -hex 32)
PORT=8081

# External Services
RESEND_API_KEY=""
GEMINI_API_KEY=""

# Application URLs
FRONTEND_URL="http://localhost:5173"
URL="http://localhost:8081/api/health"
HEALTH_WAIT=8
RUN_UPTIME_CRON=false

# Platform Administrator (controls Org Settings & pricing management)
ADMIN_EMAIL="admin@example.com"

# Demo login for payment-gateway review (min 12 chars; leave empty to disable the demo account)
DEMO_USER_PASSWORD=""

# Razorpay Payment Gateway (Live or Test Credentials)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Rate limiting: header that carries the real client IP when the API sits behind a CDN/proxy that
# overwrites it (e.g. "CF-Connecting-IP" or "True-Client-IP"). Leave empty to use X-Forwarded-For.
CLIENT_IP_HEADER=""
