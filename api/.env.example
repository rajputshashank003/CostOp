# PostgreSQL Connection String (e.g. Neon, AWS RDS, Supabase, or local Postgres)
POSTGRES_DSN="host=localhost user=postgres password=postgres dbname=costop port=5432 sslmode=disable"

# Google OAuth Credentials (console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Auth & Security
JWT_SECRET="supersecret_change_in_production"
PORT=8081

# External Services
RESEND_API_KEY=""
GEMINI_API_KEY=""

# Application URLs
FRONTEND_URL="http://localhost:5173"
URL="http://localhost:8081/api/health"
HEALTH_WAIT=8
RUN_UPTIME_CRON=false

# Platform Administrator (controls Org Settings & pricing management)
ADMIN_EMAIL="admin@example.com"

# Razorpay Payment Gateway (Live or Test Credentials)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
